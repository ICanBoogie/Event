{
  "name": "icanboogie/event",
  "type": "library",
  "description": "Provides an event API",
  "keywords": [
    "event"
  ],
  "homepage": "https://icanboogie.org/",
  "license": "BSD-3-Clause",
  "authors": [
    {
      "name": "Olivier Laviale",
      "email": "olivier.laviale@gmail.com",
      "homepage": "https://olvlvl.com/",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/ICanBoogie/Event/issues",
    "source": "https://github.com/ICanBoogie/Event"
  },
  "config": {
    "allow-plugins": {
      "olvlvl/composer-attribute-collector": true
    },
    "platform": {
      "php": "8.4.1"
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "composer/pcre": "^3.2",
    "icanboogie/service": "dev-master",
    "olvlvl/composer-attribute-collector": "^3.0",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13.4",
    "symfony/finder": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "ICanBoogie\\": "lib/"
    },
    "files": [
      "lib/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\ICanBoogie\\": "tests"
    },
    "files": [
      "vendor/attributes.php"
    ]
  },
  "extra": {
    "composer-attribute-collector": {
      "include": [
        "tests"
      ]
    }
  }
}
